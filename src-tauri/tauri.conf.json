{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AstraForge",
  "version": "0.1.0",
  "identifier": "dev.astraforge.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AstraForge", "width": 1440, "height": 960, "minWidth": 820, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "shortDescription": "Local-first AI engineering workbench", "category": "DeveloperTool", "icon": ["icons/icon.ico"] }
}
